<!--
Free Camera settings button, in the style of the Esc menu's icon buttons (options / how to play / bug report).

This is a separate GUI file (the game loads every .xml in a mod's gui/ folder) so the mod doesn't replace menus.xml or
campaign.xml and stays compatible with other UI mods. Single missions and campaign missions have different Esc menus
(Menu_Ingame and Menu_Ingame_Campaign), and an item can only have one parent, so there is one copy per menu. The
dk2_freecam plugin moves each into its menu's "Extra Buttons" row at runtime, so "origin" is relative to that row:
the options button is at 0 0, how to play at -80 0, bug report at -160 0. 0 80 puts this one right above options.

Each button's click is a Callback action, which the plugin points at "open/close the settings window" (the loader's
GuiSetCallback); without the plugin it does nothing. The game wants the target to be an existing item.
-->
<GUIItems>
	<Item name="#dk2ml_freecam" origin="0 80" hidden="true">
		<StaticImage origin="0 0">
			<RenderObject2D texture="data/textures/gui/square.tga" color="0c0b0b80" sizeX="76" sizeY="76"/>
		</StaticImage>
		<Button name="#dk2ml_freecam_button" origin="0 0" sizeX="72" sizeY="72" tooltip="Free Camera settings">
			<RenderObject2D texture="data/textures/gui/dk2ml_freecam_normal.dds" blendMode="none"/>
			<OnHover>
				<RenderObject2D texture="data/textures/gui/dk2ml_freecam_hover.dds" blendMode="none"/>
			</OnHover>
			<OnClick>
				<RenderObject2D texture="data/textures/gui/dk2ml_freecam_hover.dds" scaleX="0.95" scaleY="0.95" blendMode="none"/>
				<Action type="Callback" target="#dk2ml_freecam"/>
			</OnClick>
		</Button>
	</Item>

	<Item name="#dk2ml_freecam_campaign" origin="0 80" hidden="true">
		<StaticImage origin="0 0">
			<RenderObject2D texture="data/textures/gui/square.tga" color="0c0b0b80" sizeX="76" sizeY="76"/>
		</StaticImage>
		<Button name="#dk2ml_freecam_campaign_button" origin="0 0" sizeX="72" sizeY="72" tooltip="Free Camera settings">
			<RenderObject2D texture="data/textures/gui/dk2ml_freecam_normal.dds" blendMode="none"/>
			<OnHover>
				<RenderObject2D texture="data/textures/gui/dk2ml_freecam_hover.dds" blendMode="none"/>
			</OnHover>
			<OnClick>
				<RenderObject2D texture="data/textures/gui/dk2ml_freecam_hover.dds" scaleX="0.95" scaleY="0.95" blendMode="none"/>
				<Action type="Callback" target="#dk2ml_freecam_campaign"/>
			</OnClick>
		</Button>
	</Item>
</GUIItems>
