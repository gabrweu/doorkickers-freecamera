<!--
The HUD button (one per bar: HUD, HUD_Replay_Full) and its camera wheel. A separate file, because other HUD mods
replace hud.xml. The plugin moves each button into its bar, so origins are relative to it (HUD: suspicious areas at
400 0; HUD_Replay_Full: menu at 588 0), and moves the wheel into the clicked button's item.
Each toggle is two Buttons, one per state; the plugin shows the matching one. The wheel's rows: one slice over the
button; six on radius 230, 28 degrees apart (160 to 20); two on radius 340 (100 and 80).
The reset dialog copies menus.xml's #MessageBox_YesNo look, because that one reports through the game's own events.
The Callback actions do nothing without the plugin.
-->
<GUIItems>
	<Item name="#dk2ml_freecam_lock" origin="500 0" hidden="true">
		<Button name="#dk2ml_freecam_lock_off" tooltip="Free Camera">
			<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_off_normal.dds"/>
			<OnHover>
				<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_off_hover.dds"/>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnHover>
			<OnHoverEnd>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnHoverEnd>
			<OnClick>
				<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_off_normal.dds"/>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnClick>
		</Button>
		<Button name="#dk2ml_freecam_lock_on" hidden="true" tooltip="Free Camera (locked view)">
			<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_on_normal.dds"/>
			<OnHover>
				<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_on_hover.dds"/>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnHover>
			<OnHoverEnd>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnHoverEnd>
			<OnClick>
				<RenderObject2D texture="data/textures/hud/dk2ml_freecam_lock_on_normal.dds"/>
				<Action type="Callback" target="#dk2ml_freecam_lock"/>
			</OnClick>
